Model Building and Evaluation
Linear Regression Model on the training data  
lm_model <- lm(magnitude ~ latitude + longitude + depth_km + year + month, data = train_data)
summary(lm_model)

Comparing Actual vs. Predicted (Training)
lm_pred <- predict(lm_model, newdata = train_data)

results <- data.frame(
actual = train_data$magnitude,
predicted = lm_pred)

head(results)

Evaluating Model Performance 
r2 <- cor(results$actual, results$predicted)^2
rmse <- rmse(results$actual, results$predicted)
mae  <- mae(results$actual, results$predicted)

cat("R-squared:", round(r2, 3), "\n")
cat("RMSE:", round(rmse, 3), "\n")
cat("MAE:", round(mae, 3), "\n")

Plot of Predicted vs Actual Magnitudes 
ggplot(results, aes(x = actual, y = predicted)) +
geom_point(alpha = 0.4, color = "skyblue") +
geom_smooth(method = "lm", color = "darkblue", se = FALSE) +
labs(title = "Predicted vs Actual Earthquake Magnitude", x = "Actual Magnitude", y = "Predicted Magnitude") + theme_minimal()

Variable Linear Regression - To check which variables are more influential 
coef_summary <- tidy(lm_model) %>%
arrange(desc(abs(estimate)))
print(coef_summary)

Comparing Actual vs. Predicted (Testing)
lm_pred <- predict(lm_model, newdata = test_data)
results <- data.frame(
actual = test_data$magnitude,
predicted = lm_pred)

head(results)
