Performing Exploratory Data Analysis (Plots, Graphs, etc.)
Magnitude Distribution
ggplot(eq, aes(x = magnitude)) + 
geom_histogram(bins = 30, fill = "skyblue", color = "black") +
labs(title = "Magnitude distribution", x = "Magnitude", y = "Count") 

Depth vs. Magnitude Distribution
ggplot(eq, aes(x = depth_km, y = magnitude)) +
geom_point(alpha = 0.4, color = "skyblue", size = 2) +
geom_smooth(method = "loess", color = "#d62728", se = TRUE, linewidth = 1.2) +
labs(title = "Depth vs Magnitude of Earthquakes",
    x = "Depth (km)",
    y = "Magnitude") +
theme_minimal(base_size = 14) +
theme(
    plot.title = element_text(face = "bold", hjust = 0.5, size = 16),
    panel.grid.minor = element_blank(),
    panel.grid.major.x = element_blank())

Earthquake Counts per year
eq %>%
count(year) %>%
ggplot(aes(x = year, y = n)) +
geom_line(color = "skyblue", size = 1.2) +        
geom_point(color = "skyblue", size = 2) +           
labs(
    title = "Earthquake Counts by Year",
    x = "Year",
    y = "Count") +
theme_minimal(base_size = 13) +                     
theme(plot.title = element_text(face = "bold", hjust = 0.5),
    panel.grid.minor = element_blank())

Average Earthquake Magnitudes per Island Group (Luzon, Visayas, Mindanao)
eq_summary <- eq %>%
group_by(island_group) %>%
summarise(mean_mag = mean(magnitude, na.rm = TRUE))

ggplot(eq_summary, aes(x = island_group, y = mean_mag)) +
geom_col(fill = "skyblue", color = "gray30") +
labs(
    title = "Average Earthquake Magnitude by Island Group",
    x = "Island Group",
    y = "Mean Magnitude") +
theme_minimal(base_size = 13) +
theme(plot.title = element_text(face = "bold", hjust = 0.5))

Visual Correlation Matrix
num_vars <- eq %>% select(where(is.numeric))
cor_mat <- cor(na.omit(num_vars))
corrplot(cor_mat, method = "number")

Map Plot of Earthquakes in the Philippines
world <- ne_countries(scale = "medium", returnclass = "sf")
map_plot <- ggplot() +
geom_sf(data = world, fill = "gray95") +
geom_point(data = eq, aes(x = longitude, y = latitude, size = magnitude, color = depth_km), alpha = 0.6) +
scale_size_continuous(range = c(0.5, 4)) +
coord_sf(xlim = c(115, 130), ylim = c(5, 22)) +
labs(title = "Earthquakes in the Philippines (map)")
print(map_plot)

Predicting Earthquake Magnitude in R 
Test splitting 
Splitting test sets
set.seed(123)
split <- sample(1:nrow(eq), 0.7 * nrow(eq))
train_data <- eq[split, ]
test_data  <- eq[-split, ]

nrow(train_data) 
nrow(test_data)

Re-verifying variable names and rechecking 
names(eq) 
str(eq)

Removing NAs to prevent errors in splitting
eq <- eq %>% drop_na(magnitude, depth_km, latitude, longitude)

Re-split to verify the initial train and test data
