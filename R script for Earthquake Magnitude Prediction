Renaming and Pre-processing
Renaming
eq <- raw %>% 
clean_names() %>%
rename(date_time = date_time_ph, depth_km = depth_in_km, region = general_location)
#Other variables are no longer renamed since it is already ideal 

Changes the formatting of the date and time for analysis 
if("datetime" %in% names(eq)){
eq <- eq %>%
mutate(datetime = parse_date_time(datetime, orders = c("Ymd HMS","Y-m-d H:M:S","d/m/Y H:M","Y/m/d H:M:S","Y-m-d"), tz = "Asia/Manila"))}

Adds new columns to show year, month, day, and hour from the date_time column.
if ("date_time" %in% names(eq)) {
eq <- eq %>%
mutate(
year = lubridate::year(date_time),
month = lubridate::month(date_time, label = TRUE, abbr = TRUE),
day = lubridate::day(date_time),
hour = lubridate::hour(date_time))

Adds the island groups based on latitude information, region, etc.
eq <- eq %>%
mutate(island_group = case_when(region %in% c("Region I", "Region II", "Region III", "NCR", "CAR", "Region IV-A", "MIMAROPA", "Region V") ~ "Luzon",
region %in% c("Region VI", "Region VII", "Region VIII") ~ "Visayas",
region %in% c("Region IX", "Region X", "Region XI", "Region XII",
"Region XIII", "BARMM") ~ "Mindanao",
TRUE ~ NA_character_))

eq <- eq %>%
mutate(
island_group = case_when(
latitude >= 12 ~ "Luzon",
latitude >= 9 & latitude < 12 ~ "Visayas",
latitude < 9 ~ "Mindanao",
TRUE ~ NA_character_))

Replaces NA with Unknown and cleans up inconsistent text spaces 
eq <- eq %>%
mutate(region = ifelse(is.na(region) | region == "", "Unknown", str_squish(region)))

Removes duplicates from dataset
eq <- eq %>% distinct()

Removes rows with essential fields missing
eq <- eq %>% filter(!is.na(latitude) & !is.na(longitude) & !is.na(depth_km) & !is.na(magnitude))

Filters rows with very small magnitudes
eq <- eq %>% filter(magnitude >= 2.0)

Preview to see the cleaned version
glimpse(eq)
head(eq)

Conducting Exploratory Data Analysis in R 
Setting File Path
